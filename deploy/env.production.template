# 生产/预发环境变量模板（复制到 .env 或 /etc/campus-inventory/env 后填写）
# 切勿将真实值提交到仓库；通过 secret manager / 环境注入。

# ---- 基础 ----
DEBUG=false
# 生成：python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
ALLOWED_HOSTS=inventory.example.edu,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://inventory.example.edu

# ---- 数据库 ----
# 说明：compose 内 postgres 服务以 inventory_app 为初始超级用户（迁移 owner），
# 运行服务(web/worker/beat)由 compose 显式锁定为 inv_run（inventory_runtime 成员）。
# 本段 DB_USER 仅作参考，运行时身份以 compose 覆盖为准。
DB_NAME=campus_inventory
DB_USER=inventory_app                # 仅供 postgres 初始化参考；运行时由 compose 锁定 inv_run
MIGRATION_DB_PASSWORD=               # 迁移 owner 密码（postgres 服务初始化 inventory_app）
RUN_DB_PASSWORD=                     # 运行身份 inv_run 密码（web/worker/beat 连接）
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_KEY_PREFIX=campus_inv_

# ---- 认证签名（可选；缺省用 SECRET_KEY）----
# AUTH_SIGNING_KEY=

# ---- PII 加密（必填；逗号分隔 Fernet keys，首项加密、全部解密）----
# 生成单项：python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PII_ENCRYPTION_KEYS=

# ---- 附件存储（默认 S3；本地仅 DEBUG 用 filesystem）----
ATTACHMENT_STORAGE_BACKEND=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=us-east-1
# ATTACHMENT_S3_ENDPOINT=   # S3 兼容服务才填
ATTACHMENT_RETENTION_DAYS=    # 学校确认的保留天数（1–36525）；未填上传返回 503

# ---- 受控清理与调度（默认关闭）----
MAINTENANCE_ENABLED=false
# 形如 {"<tenant_id>":<admin_user_id>}，须为已改密启用的本校管理员
MAINTENANCE_ACTORS_JSON={}
# 证据删除开关：学校批准保留策略并核验私有桶后才开启
ATTACHMENT_CLEANUP_ENABLED=false
