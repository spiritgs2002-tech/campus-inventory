# Copy values into your process environment; never commit real secrets.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Application database example; replace with the dedicated database created by DBA.
DB_NAME=campus_inventory
DB_USER=inventory_app
DB_PASSWORD=
# Standard connection setting read by settings.py; use /tmp for the local socket.
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional separate signing key; if omitted the application SECRET_KEY is used.
# AUTH_SIGNING_KEY=
# Comma-separated Fernet keys (first encrypts, all decrypt); required for contact data.
# PII_ENCRYPTION_KEYS=
# Evidence: private S3 bucket; credentials use the normal AWS provider chain/IAM role.
ATTACHMENT_STORAGE_BACKEND=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=us-east-1
# Optional S3-compatible HTTPS endpoint; omit for AWS S3.
# ATTACHMENT_S3_ENDPOINT=
# Required: days approved under the school's evidence retention policy; no default.
ATTACHMENT_RETENTION_DAYS=
# Development only: explicitly select filesystem and a private directory outside static/.
# ATTACHMENT_STORAGE_ROOT=
# Controlled operations only. Example IDs must be replaced with actual active admins.
MAINTENANCE_ENABLED=false
MAINTENANCE_ACTORS_JSON={}
# Enable only after the school's retention policy and bucket versioning are verified.
ATTACHMENT_CLEANUP_ENABLED=false
# Anonymous QR flows: "*" all schools, empty = disabled, or tenant IDs "1,2".
ANONYMOUS_SCAN_TENANTS=*
# Unverified registrations per school per operation per minute; replay does not consume budget.
PICKUP_ANONYMOUS_PER_MINUTE=60
# Per-request cap for an unverified consumable pickup.
PICKUP_ANONYMOUS_MAX_QTY=20
# Per employee number, per anonymous operation, per rolling hour.
ANONYMOUS_PER_EMPLOYEE_PER_HOUR=10
# New unverified employee numbers per school per rolling hour.
ANONYMOUS_NEW_IDENTITIES_PER_HOUR=30
# Trust X-Forwarded-Proto only behind a reverse proxy that overwrites it.
TRUST_X_FORWARDED_PROTO=false
