name: ci
# Canonical inventory workflow. Portable copy: <app>/docs/ci/ci.yml.template.
on: [push, pull_request]
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16.15
        env:
          # Unique, disposable CI-only credential; no deployment secret is stored.
          POSTGRES_PASSWORD: ${{ github.run_id }}-${{ github.run_attempt }}-ci-only
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready --health-interval 5s
          --health-timeout 5s --health-retries 10
    env:
      DEBUG: "true"
      ALLOWED_HOSTS: localhost,127.0.0.1,testserver
      DB_HOST: 127.0.0.1
      DB_PORT: "5432"
      DB_USER: postgres
      DB_PASSWORD: ${{ github.run_id }}-${{ github.run_attempt }}-ci-only
      # DBA connection for disposable verify scripts; never apply schema here.
      DB_NAME: postgres
    steps:
      - uses: actions/checkout@v4
      - name: Locate application
        run: |
          if test -f manage.py; then
            echo 'APP_DIR=.' >> "$GITHUB_ENV"
          elif test -f inventory-v4/django/manage.py; then
            echo 'APP_DIR=inventory-v4/django' >> "$GITHUB_ENV"
          elif test -f django/manage.py; then
            echo 'APP_DIR=django' >> "$GITHUB_ENV"
          else
            echo 'Cannot locate inventory manage.py' >&2
            exit 1
          fi
      - name: Verify canonical CI delivery
        run: python "$APP_DIR/scripts/verify_ci_delivery.py" --repo-root "$GITHUB_WORKSPACE"
      - uses: astral-sh/setup-uv@v6
        with:
          version: "0.12.15"
          python-version: "3.13"
      - name: Generate ephemeral application signing key
        run: |
          python - <<'PY'
          import os
          import secrets
          key = secrets.token_urlsafe(64)
          print("::add-mask::" + key)
          with open(os.environ["GITHUB_ENV"], "a") as output:
              output.write("SECRET_KEY=" + key + "\n")
          PY
      - run: uv sync --frozen
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python manage.py precheck_sql
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python manage.py check
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python manage.py verify_config_examples
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python scripts/verify_p1.py
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python scripts/verify_p2_p3.py
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python scripts/verify_p4.py
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python scripts/verify_p5.py
        working-directory: ${{ env.APP_DIR }}
      - name: Install disposable-test Redis binary
        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends redis-server
      - run: uv run python scripts/verify_p6.py
        working-directory: ${{ env.APP_DIR }}
      - run: uv run python scripts/verify_p7.py
        working-directory: ${{ env.APP_DIR }}
      - name: Create dedicated Django suite baseline database
        working-directory: ${{ env.APP_DIR }}
        run: |
          uv run python - <<'PY'
          import os
          import psycopg
          with psycopg.connect(
              host=os.environ["DB_HOST"], port=os.environ["DB_PORT"],
              user=os.environ["DB_USER"], password=os.environ["DB_PASSWORD"],
              dbname=os.environ["DB_NAME"], autocommit=True,
          ) as admin:
              admin.execute("CREATE DATABASE campus_inventory")
          PY
      - name: Apply suite baseline
        run: uv run python manage.py apply_schema
        working-directory: ${{ env.APP_DIR }}
        env:
          DB_NAME: campus_inventory
      - name: Run full Django regression suite explicitly
        run: uv run python manage.py test tests --no-input
        working-directory: ${{ env.APP_DIR }}
        env:
          DB_NAME: campus_inventory
      - name: Verify suite schema and runtime ACL
        run: |
          uv run python manage.py verify_schema
          uv run python manage.py verify_runtime
        working-directory: ${{ env.APP_DIR }}
        env:
          DB_NAME: campus_inventory
      - name: Verify readiness with real local dependencies
        run: uv run python scripts/verify_readiness.py
        working-directory: ${{ env.APP_DIR }}
      - name: Verify requirements match the frozen lock
        run: |
          uv export --frozen --format requirements-txt --output-file requirements.txt > /dev/null
          git diff --exit-code -- requirements.txt
        working-directory: ${{ env.APP_DIR }}
