# CI workflow — inventory-v4 (Django campus inventory)
# Place at <git-repo-root>/.github/workflows/ci.yml
# NOTE: this project's Python root (manage.py / pyproject.toml) is `django/`.
# If your git repository root is `inventory-v4/` rather than `inventory-v4/django/`,
# either move this file to `inventory-v4/.github/workflows/ci.yml` OR add
# `defaults.run.working-directory: django` and keep it here.
name: CI

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  verify-and-test:
    runs-on: ubuntu-latest
    # Django 5.2 requires Python >= 3.10; project targets 3.13.
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install uv
        uses: astral-sh/setup-uv@v5

      - name: Sync dependencies (frozen)
        run: uv sync --frozen

      # B9 gate: requirements.txt must stay in sync with the locked environment.
      - name: Assert requirements.txt is in sync
        run: |
          uv export --frozen --format requirements-txt --no-hashes > /tmp/req_export.txt
          # Strip the autogenerated header that uv emits, then diff core pins.
          diff <(grep -E '^[a-zA-Z0-9_.-]+==' /tmp/req_export.txt | sort) \
               <(grep -E '^[a-zA-Z0-9_.-]+==' requirements.txt | sort) \
            && echo "requirements.txt in sync" \
            || { echo "requirements.txt OUT OF SYNC with uv.lock"; exit 1; }

      - name: Start PostgreSQL 16
        run: |
          sudo apt-get update
          sudo apt-get install -y postgresql-16 postgresql-client-16
          sudo pg_ctlcluster 16 main start
          sudo -u postgres psql -c "ALTER USER postgres PASSWORD 'postgres';"

      - name: Start Redis 7
        run: |
          sudo apt-get install -y redis-server
          sudo redis-server --daemonize yes --port 6379
          redis-cli ping

      - name: Create database and roles
        env:
          PGPASSWORD: postgres
        run: |
          psql -h localhost -U postgres -c "SELECT 1 FROM pg_database WHERE datname='campus_inventory'" | grep -q 1 || \
            psql -h localhost -U postgres -c "CREATE DATABASE campus_inventory"
          psql -h localhost -U postgres -v ON_ERROR_STOP=1 <<'SQL'
          DO $$ BEGIN
            IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='inventory_app') THEN
              CREATE ROLE inventory_app LOGIN PASSWORD 'ci-app';
            END IF;
            IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='inventory_runtime') THEN
              CREATE ROLE inventory_runtime NOLOGIN;
            END IF;
          END $$;
          SQL

      - name: Apply schema (G0)
        env:
          DB_HOST: localhost
          DB_PORT: "5432"
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: campus_inventory
          SECRET_KEY: ci-only-not-a-secret-0123456789
          DEBUG: "false"
          ALLOWED_HOSTS: localhost,127.0.0.1,testserver
          DJANGO_SETTINGS_MODULE: campus_inventory.settings
        run: uv run python manage.py apply_schema

      - name: Verify schema + runtime ACL (M1)
        env:
          DB_HOST: localhost
          DB_PORT: "5432"
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: campus_inventory
          SECRET_KEY: ci-only-not-a-secret-0123456789
          DEBUG: "false"
          ALLOWED_HOSTS: localhost,127.0.0.1,testserver
          DJANGO_SETTINGS_MODULE: campus_inventory.settings
        run: |
          uv run python manage.py verify_schema
          uv run python manage.py verify_runtime

      # p7 verify + readiness need a live worker/beat, so start them in the background.
      - name: Start Celery worker + beat (background)
        env:
          DB_HOST: localhost
          DB_PORT: "5432"
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: campus_inventory
          REDIS_URL: redis://localhost:6379/0
          SECRET_KEY: ci-only-not-a-secret-0123456789
          DEBUG: "false"
          ALLOWED_HOSTS: localhost,127.0.0.1,testserver
          DJANGO_SETTINGS_MODULE: campus_inventory.settings
          MAINTENANCE_ENABLED: "true"
        run: |
          uv run celery -A campus_inventory worker --concurrency 2 -D &
          uv run celery -A campus_inventory beat -D &
          sleep 8

      - name: Run phase verify scripts (p1..p7 + readiness)
        env:
          DB_HOST: localhost
          DB_PORT: "5432"
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: campus_inventory
          REDIS_URL: redis://localhost:6379/0
          SECRET_KEY: ci-only-not-a-secret-0123456789
          DEBUG: "false"
          ALLOWED_HOSTS: localhost,127.0.0.1,testserver
          DJANGO_SETTINGS_MODULE: campus_inventory.settings
        run: |
          for s in verify_p1 verify_p2_p3 verify_p4 verify_p5 verify_p6 verify_p7 verify_readiness; do
            echo "=== scripts/$s.py ==="
            uv run python scripts/$s.py
          done

      # B6 gate: the authoritative Django regression suite must run in CI.
      - name: Django test suite (155 tests)
        env:
          DB_HOST: localhost
          DB_PORT: "5432"
          DB_USER: postgres
          DB_PASSWORD: postgres
          DB_NAME: campus_inventory
          REDIS_URL: redis://localhost:6379/0
          SECRET_KEY: ci-only-not-a-secret-0123456789
          DEBUG: "false"
          ALLOWED_HOSTS: localhost,127.0.0.1,testserver
          DJANGO_SETTINGS_MODULE: campus_inventory.settings
        run: uv run python manage.py test tests --no-input
